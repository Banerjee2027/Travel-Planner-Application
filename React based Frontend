import React, { useState } from "react";

export default function App() {
  const [destination, setDestination] = useState("");
  const [budget, setBudget] = useState("");
  const [days, setDays] = useState("");
  const [itinerary, setItinerary] = useState([]);

  const generateItinerary = () => {
    if (!destination || !budget || !days) return;

    const plan = [];
    for (let i = 1; i <= days; i++) {
      plan.push({
        day: i,
        activity: `Explore ${destination} - Day ${i} activities`,
        cost: Math.floor(budget / days),
      });
    }
    setItinerary(plan);
  };

  return (
    <div className="min-h-screen bg-gray-100 p-6">
      <h1 className="text-3xl font-bold text-center mb-6">
        Smart Travel Planner
      </h1>

      <div className="max-w-xl mx-auto bg-white p-6 rounded-2xl shadow">
        <input
          type="text"
          placeholder="Enter Destination"
          className="w-full p-2 border rounded mb-3"
          value={destination}
          onChange={(e) => setDestination(e.target.value)}
        />

        <input
          type="number"
          placeholder="Enter Budget (₹)"
          className="w-full p-2 border rounded mb-3"
          value={budget}
          onChange={(e) => setBudget(e.target.value)}
        />

        <input
          type="number"
          placeholder="Number of Days"
          className="w-full p-2 border rounded mb-3"
          value={days}
          onChange={(e) => setDays(e.target.value)}
        />

        <button
          onClick={generateItinerary}
          className="w-full bg-blue-600 text-white p-2 rounded hover:bg-blue-700"
        >
          Generate Itinerary
        </button>
      </div>

      {itinerary.length > 0 && (
        <div className="max-w-xl mx-auto mt-6">
          <h2 className="text-xl font-semibold mb-3">Your Itinerary</h2>
          {itinerary.map((item) => (
            <div
              key={item.day}
              className="bg-white p-4 rounded shadow mb-2"
            >
              <p className="font-bold">Day {item.day}</p>
              <p>{item.activity}</p>
              <p className="text-sm text-gray-600">
                Estimated Cost: ₹{item.cost}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
