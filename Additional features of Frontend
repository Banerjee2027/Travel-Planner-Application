function renderNotifs(){ 
  const list = document.getElementById('notif-list'); 
  list.innerHTML = notifs.map(n=>` 
    <div class="notif-card" style="background:${n.bg}20;border:1px solid ${n.bg}"> 
      <div class="notif-icon" style="background:${n.bg}">${n.icon}</div> 
      <div class="notif-body"> 
        <div class="notif-title">${n.title}</div> 
        <div class="notif-text">${n.text}</div> 
        <div style="display:flex;align-items:center;gap:10px;margin-top:5px"> 
          <span class="notif-time">${n.time}</span> 
          <button class="notif-action">${n.action} →</button> 
        </div> 
      </div> 
      <div class="notif-dot ${n.unread?'unread':'read'}"></div> 
    </div>`).join(''); 
 
  const sett = document.getElementById('notif-settings'); 
  sett.innerHTML = settings.map((s,i)=>` 
    <div class="notif-switch-row"> 
      <div><div class="notif-switch-lbl">${s.label}</div><div class="notif-switch
desc">${s.desc}</div></div> 
      <div class="toggle ${i<4?'on':''}" onclick="this.classList.toggle('on')"></div> 
    </div>`).join(''); 
} 
renderNotifs(); 
 
// ── Offline Maps ── 
function downloadMap(id){ 
const btn = document.getElementById('dl-'+id); 
if(btn.classList.contains('done')) return; 
btn.textContent = '⬇ 0%'; 
btn.disabled = true; 
let p=0; 
const iv = setInterval(()=>{ 
p += Math.floor(Math.random()*15)+5; 
if(p>=100){p=100;clearInterval(iv);btn.textContent='✓ 
Saved';btn.classList.add('done');btn.disabled=false;} 
else btn.textContent='⬇ '+p+'%'; 
},200); 
} 
// ── Set today's date ── 
document.getElementById('dep').value = new Date().toISOString().split('T')[0]; 
