<!DOCTYPE html> 
<html lang="en"> 
<head> 
<meta charset="UTF-8" /> 
<meta name="viewport" content="width=device-width, initial-scale=1.0" /> 
<title>Voyago — Smart Travel Planner</title> 
<link rel="preconnect" href="https://fonts.googleapis.com" /> 
<link 
href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,70
0;1,500&family=Sora:wght@300;400;500;600&display=swap" rel="stylesheet" /> 
<style> 
*{box-sizing:border-box;margin:0;padding:0} 
:root{ --ink:#0d1117;--ink2:#1e2a3a;--ink3:#2e3d52; --sky:#1a6cf6;--sky2:#3d87f5;--sky3:#d0e6ff; --jade:#00b87a;--jade2:#d0f5e8; --sun:#f5a623;--sun2:#fff3d0; --rose:#e8365d;--rose2:#fde8ee; --sand:#f7f4ef;--sand2:#ede9e1; --white:#ffffff; --text1:#0d1117;--text2:#4a5568;--text3:#8a96a3; --radius:14px;--radius-sm:9px; --shadow:0 2px 12px rgba(0,0,0,0.08); --shadow-lg:0 8px 32px rgba(0,0,0,0.14); 
} 
html,body{height:100%;background:var(--sand);font-family:'Sora',sans-serif;color:var(-
text1);overflow:hidden} 
/* ── App Shell ── */ 
.app{display:flex;flex-direction:column;height:100vh;max-width:430px;margin:0 
auto;background:var(--white);position:relative;overflow:hidden;box-shadow:0 0 60px 
rgba(0,0,0,0.18)} 
/* ── Screens ── */ 
.screen{position:absolute;inset:0;bottom:68px;overflow-y:auto;opacity:0;pointer
events:none;transform:translateY(8px);transition:opacity .22s ease,transform .22s 
ease} 
.screen.active{opacity:1;pointer-events:all;transform:translateY(0)} 
/* ── Bottom Nav ── */ 
.nav{position:absolute;bottom:0;left:0;right:0;height:68px;background:var(-
white);border-top:1px solid #eef0f3;display:flex;align-items:center;z-index:100} 
.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;font
size:9.5px;font-weight:500;letter-spacing:.04em;color:var(-
text3);cursor:pointer;border:none;background:none;font-family:'Sora',sans
serif;padding:6px 0;transition:color .15s;text-transform:uppercase} 
.nav-btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.6} 
.nav-btn.on{color:var(--sky)} 
/* ── Hero ── */ 
.hero{background:var(--ink);padding:28px 20px 
22px;position:relative;overflow:hidden;flex-shrink:0} 
.hero::before{content:'';position:absolute;top:-80px;right:
60px;width:260px;height:260px;border-radius:50%;background:radial
gradient(circle,rgba(26,108,246,.25) 0%,transparent 70%)} 
.hero::after{content:'';position:absolute;bottom:
40px;left:20px;width:140px;height:140px;border-radius:50%;background:radial
gradient(circle,rgba(0,184,122,.15) 0%,transparent 70%)} 
.hero-chip{display:inline-flex;align
items:center;gap:5px;background:rgba(0,184,122,.15);border:1px solid 
rgba(0,184,122,.3);border-radius:20px;padding:3px 10px;font-size:10px;font
weight:600;color:var(--jade);letter-spacing:.08em;margin-bottom:10px;text
transform:uppercase} 
.hero h1{font-family:'Playfair Display',serif;font-size:2rem;color:#f0ede8;line
height:1.15;margin-bottom:5px} 
.hero h1 em{color:var(--sky2);font-style:italic} 
.hero p{font-size:12.5px;color:rgba(240,237,232,.5);font-weight:300;margin
bottom:20px} 
/* ── Search Bar ── */ 
.search-box{background:rgba(255,255,255,.07);border:1px solid 
rgba(255,255,255,.12);border-radius:var(--radius);padding:14px;position:relative;z
index:1} 
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px} 
.field{display:flex;flex-direction:column;gap:4px} 
.field label{font-size:9.5px;font-weight:600;letter-spacing:.1em;text
transform:uppercase;color:rgba(240,237,232,.4)} 
.field input,.field select{background:rgba(255,255,255,.08);border:1px solid 
rgba(255,255,255,.1);border-radius:9px;padding:8px 10px;font-size:13px;font
family:'Sora',sans-serif;color:#f0ede8;outline:none;width:100%} 
.field input::placeholder{color:rgba(240,237,232,.3)} 
.field select option{background:#1e2a3a;color:#f0ede8} 
.plan-btn{width:100%;margin-top:10px;background:var(--sky);border:none;border
radius:10px;padding:12px;font-size:13.5px;font-weight:600;font-family:'Sora',sans
serif;color:#fff;cursor:pointer;display:flex;align-items:center;justify
content:center;gap:7px;transition:background .15s} 
.plan-btn:hover{background:#1259d4} 
/* ── Body Pad ── */ 
.body{padding:18px} 
.sec-label{font-size:10px;font-weight:600;letter-spacing:.12em;text
transform:uppercase;color:var(--text3);margin-bottom:12px} 
/* ── Chips ── */ 
.chips{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:22px} 
.chip{border:1px solid #dde1e7;border-radius:20px;padding:6px 13px;font
size:12px;cursor:pointer;color:var(--text2);background:var(--white);transition:all 
.15s;font-weight:500} 
.chip.on{background:var(--ink);color:#7BC5F0;border-color:var(--sky)} 
/* ── Dest Cards ── */ 
.dest-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:22px} 
.dcard{border:1px solid #eef0f3;border-radius:var(-
radius);overflow:hidden;cursor:pointer;transition:transform .15s,box-shadow .15s} 
.dcard:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)} 
.dcard-img{height:88px;display:flex;align-items:flex-end;padding:8px} 
.dcard-body{padding:10px 12px} 
.dcard-body h3{font-size:13px;font-weight:600;margin-bottom:2px} 
.dcard-body p{font-size:11px;color:var(--text3);margin-bottom:7px} 
.dcard-foot{display:flex;justify-content:space-between;align-items:center} 
.price{font-size:12.5px;font-weight:600;color:var(--jade)} 
.badge{font-size:9.5px;padding:3px 8px;border-radius:10px;font-weight:600} 
.badge.hot{background:var(--rose2);color:var(--rose)} 
.badge.new{background:var(--jade2);color:#007a52} 
.badge.deal{background:var(--sky3);color:#0047b3} 
/* ── AI Button ── */ 
.ai-btn{width:100%;background:var(--ink);border:1px solid var(--sky);border-radius:var(--radius);padding:13px;font-size:13px;font-family:'Sora',sans-serif;font
weight:500;color:#7BC5F0;cursor:pointer;display:flex;align-items:center;justify
content:center;gap:8px;transition:background .15s;margin-top:4px} 
.ai-btn:hover{background:#1a2740} 
/* ── Itinerary ── */ 
.itin-header{display:flex;justify-content:space-between;align-items:center;margin
bottom:16px} 
.itin-title{font-family:'Playfair Display',serif;font-size:1.4rem} 
.ai-tag{font-size:11px;color:var(--jade);font-weight:600;background:var(-
jade2);padding:3px 10px;border-radius:10px} 
.stats3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px} 
.stat{background:var(--sand);border-radius:10px;padding:12px 8px;text-align:center} 
.stat-v{font-size:18px;font-weight:600} 
.stat-l{font-size:10.5px;color:var(--text3);margin-top:2px} 
.plan-box{background:var(--sand);border-radius:var(--radius);padding:16px;margin
bottom:16px} 
.plan-hdr{display:flex;justify-content:space-between;align-items:center;margin
bottom:14px} 
.plan-hdr-t{font-family:'Playfair Display',serif;font-size:1.05rem} 
.edit-btn{font-size:12px;color:var(-
sky);border:none;background:none;cursor:pointer;font-family:'Sora',sans-serif;font
weight:500} 
.timeline{display:flex;flex-direction:column} 
.tday{display:flex;gap:12px;padding-bottom:16px;position:relative} 
.tday:not(:last
child)::before{content:'';position:absolute;left:13px;top:27px;bottom:0;width:1px;back
ground:#dde1e7} 
.tdot{width:27px;height:27px;border-radius:50%;background:var(--ink);border:2px solid 
var(--sky);display:flex;align-items:center;justify-content:center;font-size:10.5px;font
weight:600;color:#7BC5F0;flex-shrink:0;margin-top:1px} 
.tday-c h4{font-size:13px;font-weight:600;margin-bottom:3px} 
.tday-c p{font-size:11.5px;color:var(--text2);line-height:1.55} 
.tday-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px} 
.ttag{font-size:10px;background:var(--sky3);color:#0047b3;border
radius:8px;padding:2px 8px;font-weight:500} 
.ttag.food{background:var(--sun2);color:#8a5200} 
.ttag.nature{background:var(--jade2);color:#007a52} 
/* ── Hotels ── */ 
.hotel-card{border:1px solid #eef0f3;border-radius:var(-
radius);overflow:hidden;margin-bottom:12px;cursor:pointer;transition:box-shadow 
.15s} 
.hotel-card:hover{box-shadow:var(--shadow)} 
.hotel-img{height:120px;position:relative} 
.hotel
tag{position:absolute;top:10px;left:10px;background:rgba(0,0,0,.6);color:#fff;font
size:10px;font-weight:600;padding:3px 9px;border-radius:8px;letter-spacing:.04em} 
.hotel-body{padding:12px 14px} 
.hotel-row{display:flex;justify-content:space-between;align-items:flex-start;margin
bottom:5px} 
.hotel-name{font-size:14px;font-weight:600} 
.hotel-stars{color:var(--sun);font-size:12px;letter-spacing:2px} 
.hotel-loc{font-size:11.5px;color:var(--text3);margin-bottom:8px;display:flex;align
items:center;gap:4px} 
.hotel-foot{display:flex;justify-content:space-between;align-items:center} 
.hotel-price{font-size:14px;font-weight:600;color:var(--ink)} 
.hotel-price span{font-size:11px;font-weight:400;color:var(--text3)} 
.book-btn{background:var(--sky);color:#fff;border:none;border-radius:8px;padding:7px 
14px;font-size:12px;font-weight:600;font-family:'Sora',sans-serif;cursor:pointer} 
.hotel-amenities{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px} 
.amenity{font-size:10px;background:var(--sand);color:var(--text2);border
radius:7px;padding:3px 8px;font-weight:500} 
/* ── Map ── */ 
.map-container{position:relative;background:#c9d8e8;height:260px;border-radius:var(--radius);overflow:hidden;margin-bottom:16px} 
.map-svg{width:100%;height:100%} 
.map-overlay{position:absolute;top:12px;left:12px;right:12px;display:flex;gap:8px} 
.map-search{flex:1;background:var(--white);border:none;border
radius:9px;padding:9px 12px;font-size:12.5px;font-family:'Sora',sans-serif;box
shadow:var(--shadow)} 
.map-btn{background:var(--white);border:none;border-radius:9px;padding:9px 
12px;font-size:12px;font-weight:600;font-family:'Sora',sans-serif;color:var(-
sky);cursor:pointer;box-shadow:var(--shadow);white-space:nowrap} 
.route-info{background:var(--ink);color:#f0ede8;border-radius:var(-
radius);padding:14px 16px;margin-bottom:16px} 
.route-title{font-size:12px;font-weight:600;letter-spacing:.06em;text
transform:uppercase;color:rgba(240,237,232,.5);margin-bottom:10px} 
.route-stops{display:flex;flex-direction:column;gap:0} 
.rstop{display:flex;align-items:center;gap:10px;padding:8px 0;position:relative} 
.rstop:not(:last-child)::after{content:'';position:absolute;left:9px;bottom:
8px;width:2px;height:16px;background:rgba(255,255,255,.2)} 
.rdot{width:20px;height:20px;border-radius:50%;background:var(-
sky);display:flex;align-items:center;justify-content:center;flex-shrink:0} 
.rdot svg{width:10px;height:10px;fill:#fff;stroke:none} 
.rdot.end{background:var(--rose)} 
.rstop-info{flex:1} 
.rstop-name{font-size:13px;font-weight:500} 
.rstop-detail{font-size:11px;color:rgba(240,237,232,.5)} 
.rstop-time{font-size:12px;font-weight:600;color:var(--sky2)} 
.transport-cards{display:flex;gap:9px;overflow-x:auto;padding-bottom:8px;margin
bottom:16px;scrollbar-width:none} 
.transport-cards::-webkit-scrollbar{display:none} 
.tcard{flex-shrink:0;width:130px;background:var(--sand);border-radius:var(--radius
sm);padding:12px;border:1px solid #dde1e7} 
.tcard-icon{width:36px;height:36px;border-radius:9px;display:flex;align
items:center;justify-content:center;margin-bottom:8px;font-size:18px} 
.tcard h4{font-size:12px;font-weight:600;margin-bottom:2px} 
.tcard p{font-size:10.5px;color:var(--text3);line-height:1.4} 
.tcard-badge{display:inline-block;margin-top:5px;font-size:9.5px;font
weight:600;padding:2px 7px;border-radius:7px} 
/* ── Packing ── */ 
.pack-category{background:var(--sand);border-radius:var(-
radius);padding:14px;margin-bottom:12px} 
.pack-cat-hdr{display:flex;justify-content:space-between;align-items:center;margin
bottom:10px} 
.pack-cat-title{font-size:13px;font-weight:600;display:flex;align-items:center;gap:7px} 
.pack-progress{font-size:11px;color:var(--text3)} 
.pack-bar{height:4px;background:#dde1e7;border-radius:2px;margin
bottom:12px;overflow:hidden} 
.pack-fill{height:100%;border-radius:2px;background:var(--jade);transition:width .3s} 
.pack-item{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px 
solid #eef0f3;cursor:pointer} 
.pack-item:last-child{border-bottom:none} 
.pack-check{width:20px;height:20px;border-radius:6px;border:2px solid 
#dde1e7;display:flex;align-items:center;justify-content:center;flex
shrink:0;transition:all .15s} 
.pack-check.done{background:var(--jade);border-color:var(--jade)} 
.pack-check.done::after{content:'✓';font-size:11px;color:#fff;font-weight:700} 
.pack-item.done .pack-text{text-decoration:line-through;color:var(--text3)} 
.pack-text{font-size:13px} 
.pack-add{display:flex;gap:8px;margin-top:12px} 
.pack-add input{flex:1;border:1px solid #dde1e7;border-radius:9px;padding:8px 
12px;font-size:13px;font-family:'Sora',sans-serif;outline:none} 
.pack-add button{background:var(--sky);color:#fff;border:none;border
radius:9px;padding:8px 14px;font-size:13px;font-weight:600;font-family:'Sora',sans
serif;cursor:pointer} 
/* ── Tips & Reviews ── */ 
.tip-tabs{display:flex;gap:0;background:var(--sand);border
radius:10px;padding:3px;margin-bottom:16px} 
.tip-tab{flex:1;padding:7px;text-align:center;font-size:12px;font
weight:600;border:none;background:none;font-family:'Sora',sans-serif;color:var(-
text3);border-radius:8px;cursor:pointer;transition:all .15s} 
.tip-tab.on{background:var(--white);color:var(--text1);box-shadow:var(--shadow)} 
.review-card{border:1px solid #eef0f3;border-radius:var(--radius);padding:14px;margin
bottom:12px} 
.rev-hdr{display:flex;align-items:center;gap:10px;margin-bottom:9px} 
.rev-avatar{width:36px;height:36px;border-radius:50%;display:flex;align
items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex
shrink:0} 
.rev-name{font-size:13px;font-weight:600} 
.rev-date{font-size:11px;color:var(--text3)} 
.rev-stars{color:var(--sun);font-size:13px;margin-bottom:5px} 
.rev-text{font-size:12.5px;color:var(--text2);line-height:1.6} 
.rev-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px} 
.rtag{font-size:10px;background:var(--sand2);color:var(--text2);border
radius:7px;padding:3px 8px;font-weight:500} 
.food-card{display:flex;gap:12px;border:1px solid #eef0f3;border-radius:var(-
radius);padding:12px;margin-bottom:10px;cursor:pointer} 
.food-img{width:64px;height:64px;border-radius:10px;flex
shrink:0;overflow:hidden;display:flex;align-items:center;justify-content:center;font
size:28px} 
.food-info h4{font-size:13px;font-weight:600;margin-bottom:3px} 
.food-info p{font-size:11.5px;color:var(--text3);margin-bottom:5px;line-height:1.4} 
.food-foot{display:flex;align-items:center;gap:8px} 
.food-price{font-size:12px;font-weight:600;color:var(--ink)} 
.food-rating{font-size:11px;color:var(--sun);font-weight:600} 
/* ── Weather ── */ 
.weather-hero{background:linear-gradient(145deg,var(--ink),var(--ink3));border
radius:var(--radius);padding:20px;margin
bottom:16px;position:relative;overflow:hidden} 
.weather-hero::before{content:'';position:absolute;top:-30px;right:
30px;width:140px;height:140px;border-radius:50%;background:radial
gradient(circle,rgba(245,166,35,.2) 0%,transparent 70%)} 
.wh-city{font-size:11px;color:rgba(240,237,232,.5);font-weight:600;letter
spacing:.1em;text-transform:uppercase;margin-bottom:5px} 
.wh-temp{font-family:'Playfair Display',serif;font-size:3.5rem;color:#f0ede8;line
height:1;margin-bottom:5px} 
.wh-temp span{font-size:1.5rem} 
.wh-desc{font-size:14px;color:rgba(240,237,232,.7);margin-bottom:14px} 
.wh-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:8px} 
.wh-item{text-align:center} 
.wh-item-val{font-size:14px;font-weight:600;color:#f0ede8} 
.wh-item-lbl{font-size:10px;color:rgba(240,237,232,.45);margin-top:2px} 
.forecast-strip{display:flex;gap:9px;overflow-x:auto;padding-bottom:6px;margin
bottom:16px;scrollbar-width:none} 
.forecast-strip::-webkit-scrollbar{display:none} 
.fc-day{flex-shrink:0;width:70px;background:var(--sand);border-radius:var(--radius
sm);padding:10px 8px;text-align:center;border:1px solid #dde1e7} 
.fc-day.today{background:var(--ink);border-color:var(--sky)} 
.fc-day-name{font-size:10px;font-weight:600;letter-spacing:.05em;text
transform:uppercase;color:var(--text3);margin-bottom:5px} 
.fc-day.today .fc-day-name{color:rgba(240,237,232,.5)} 
.fc-icon{font-size:22px;margin-bottom:5px} 
.fc-temp{font-size:13px;font-weight:600} 
.fc-day.today .fc-temp{color:#f0ede8} 
/* ── Culture ── */ 
.culture-card{border-radius:var(--radius);overflow:hidden;margin-bottom:12px} 
.cc-top{padding:14px 16px;display:flex;align-items:center;gap:12px} 
.cc-icon{width:44px;height:44px;border-radius:10px;display:flex;align
items:center;justify-content:center;font-size:22px;flex-shrink:0} 
.cc-title{font-size:14px;font-weight:600;margin-bottom:2px} 
.cc-sub{font-size:11.5px;color:var(--text3)} 
.cc-body{padding:0 16px 14px} 
.cc-text{font-size:12.5px;color:var(--text2);line-height:1.65} 
.cc-tips{display:flex;flex-direction:column;gap:5px;margin-top:10px} 
.cc-tip{display:flex;align-items:flex-start;gap:7px;font-size:12px;color:var(--text2)} 
.cc-tip::before{content:'→';font-size:12px;color:var(--sky);flex-shrink:0;margin-top:1px} 
.do-dont{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px} 
.dd-box{border-radius:var(--radius-sm);padding:12px} 
.dd-box.do{background:var(--jade2)} 
.dd-box.dont{background:var(--rose2)} 
.dd-title{font-size:11px;font-weight:700;letter-spacing:.08em;text
transform:uppercase;margin-bottom:8px} 
.dd-box.do .dd-title{color:#007a52} 
.dd-box.dont .dd-title{color:var(--rose)} 
.dd-item{font-size:11.5px;margin-bottom:5px;display:flex;gap:5px;line-height:1.4} 
/* ── Notifications ── */ 
.notif-card{border-radius:var(--radius);padding:14px 16px;margin
bottom:10px;display:flex;gap:12px;cursor:pointer;transition:transform .1s} 
.notif-card:hover{transform:scale(1.01)} 
.notif-card:active{transform:scale(0.99)} 
.notif-icon{width:42px;height:42px;border-radius:11px;display:flex;align
items:center;justify-content:center;font-size:20px;flex-shrink:0} 
.notif-body{flex:1} 
.notif-title{font-size:13px;font-weight:600;margin-bottom:3px} 
.notif-text{font-size:11.5px;color:var(--text2);line-height:1.5;margin-bottom:5px} 
.notif-time{font-size:10.5px;color:var(--text3);font-weight:500} 
.notif-action{display:inline-flex;align-items:center;gap:4px;font-size:11px;font
weight:600;color:var(--sky);background:var(--sky3);border:none;border
radius:7px;padding:4px 10px;cursor:pointer;font-family:'Sora',sans-serif;margin
top:4px} 
.notif-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:4px} 
.notif-dot.unread{background:var(--sky)} 
.notif-dot.read{background:transparent} 
.notif-switch-row{display:flex;justify-content:space-between;align
items:center;padding:12px 0;border-bottom:1px solid #eef0f3} 
.notif-switch-lbl{font-size:13px;font-weight:500} 
.notif-switch-desc{font-size:11.5px;color:var(--text3);margin-top:2px} 
.toggle{width:44px;height:24px;border
radius:12px;background:#dde1e7;position:relative;cursor:pointer;transition:backgroun
d .2s;flex-shrink:0} 
.toggle.on{background:var(--sky)} 
.toggle::after{content:'';position:absolute;width:18px;height:18px;border
radius:50%;background:#fff;top:3px;left:3px;transition:left .2s;box-shadow:0 1px 4px 
rgba(0,0,0,.2)} 
.toggle.on::after{left:23px} 
/* ── Offline ── */ 
.offline-hero{background:var(--ink);border-radius:var(--radius);padding:18px;margin
bottom:16px;display:flex;align-items:center;gap:14px} 
.offline-icon{width:52px;height:52px;border
radius:14px;background:rgba(0,184,122,.15);display:flex;align-items:center;justify
content:center;font-size:24px;flex-shrink:0} 
